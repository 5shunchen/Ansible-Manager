# ===== ansible-manager 环境配置示例 =====
# 复制为 .env 后按需修改

# 应用
DEBUG=false

# 数据库
# MySQL:   mysql+aiomysql://root:yourpass@127.0.0.1:3306/ansible_manager
# SQLite:  sqlite+aiosqlite:///./data/ansible_manager.db
DATABASE_URL=sqlite+aiosqlite:///./data/ansible_manager.db

# 安全（生产必改）
JWT_SECRET=please-change-me-to-a-random-string
CREDENTIAL_SECRET=b0fG9z4C3q7vAmSxK1Lw8uYt2NcRj5HhP0oEi6UdXgM=

# 任务
TASK_MAX_CONCURRENT=5
TASK_DEFAULT_TIMEOUT=3600

# 监控采集（运行时可改的项在 sys_config 表，此处为初始值）
COLLECT_INTERVAL_SECONDS=60
COLLECT_CONCURRENCY=20
METRIC_RETENTION_DAYS=30
